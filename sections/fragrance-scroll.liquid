{%- comment -%}
  Fragrance scroll: el componente React de frontend/ (compilado a assets/fragrance-scroll.js y .css).
  Esta sección sólo arma la config que en el sandbox sale de config/assets.js y data/fragrances.js:
    { showLabel,
      fragrances: [{ blockId, slug, name, ingredients, ingredientStretch, url }],
      assets: { bottles: { slug: url }, ingredients: { slug: [url, url, url] }, backgrounds: [url] } }

  - slug: el `slugify` del componente (minúsculas, espacios y guiones a "_"): wonder_of_the_world.
  - Imágenes: la del image picker si se cargó; si no, la de assets/ del tema por convención de nombre,
    con la fragancia en camelCase (wonderOfTheWorld_botella.png, wonderOfTheWorld_ingredientes1.webp)
    y los fondos bg1_background.jpg, bg2..4_background.webp.
  - url: la del producto elegido; si no hay, /products/<handle del nombre> (ej. /products/forbidden-flower).
{%- endcomment -%}

{%- liquid
  assign root_url = routes.root_url
  if root_url == '/'
    assign root_url = ''
  endif

  assign fragrances_json = ''
  assign bottles_json = ''
  assign ingredients_json = ''

  for block in section.blocks
    assign name = block.settings.title | strip
    if name == blank
      continue
    endif

    assign words = name | replace: '-', ' ' | split: ' '
    assign slug = words | join: '_' | downcase
    assign camel = ''
    for word in words
      if forloop.first
        assign part = word | downcase
      else
        assign part = word | capitalize
      endif
      assign camel = camel | append: part
    endfor

    if block.settings.product != blank
      assign url = block.settings.product.url
    else
      assign handle = name | handleize
      assign url = root_url | append: '/products/' | append: handle
    endif

    assign ingredient_names = ''
    for i in (1..3)
      assign key = 'ingredient_' | append: i
      assign ingredient = block.settings[key] | strip
      if ingredient != blank
        assign ingredient_names = ingredient_names | append: '|' | append: ingredient
      endif
    endfor
    assign ingredient_names = ingredient_names | remove_first: '|' | split: '|'

    if block.settings.bottle != blank
      assign bottle_url = block.settings.bottle | image_url: width: 1800
    else
      assign bottle_url = camel | append: '_botella.png' | asset_url
    endif

    capture fragrance
      echo '{"blockId":'
      echo block.id | json
      echo ',"slug":'
      echo slug | json
      echo ',"name":'
      echo name | json
      echo ',"ingredients":'
      echo ingredient_names | json
      echo ',"ingredientStretch":'
      if block.settings.stretch_x == 1 and block.settings.stretch_y == 1
        echo 'null'
      else
        echo '{"scaleX":'
        echo block.settings.stretch_x
        echo ',"scaleY":'
        echo block.settings.stretch_y
        echo '}'
      endif
      echo ',"url":'
      echo url | json
      echo '}'
    endcapture

    capture bottle
      echo slug | json
      echo ':'
      echo bottle_url | json
    endcapture

    capture variants
      echo slug | json
      echo ':['
      for i in (1..3)
        assign key = 'ingredient_image_' | append: i
        if block.settings[key] != blank
          assign variant_url = block.settings[key] | image_url: width: 1600
        else
          assign variant_url = camel | append: '_ingredientes' | append: i | append: '.webp' | asset_url
        endif
        unless forloop.first
          echo ','
        endunless
        echo variant_url | json
      endfor
      echo ']'
    endcapture

    if fragrances_json != blank
      assign fragrances_json = fragrances_json | append: ','
      assign bottles_json = bottles_json | append: ','
      assign ingredients_json = ingredients_json | append: ','
    endif
    assign fragrances_json = fragrances_json | append: fragrance
    assign bottles_json = bottles_json | append: bottle
    assign ingredients_json = ingredients_json | append: variants
  endfor

  assign default_backgrounds = 'bg1_background.jpg,bg2_background.webp,bg3_background.webp,bg4_background.webp' | split: ','
  capture backgrounds_json
    for default_background in default_backgrounds
      assign key = 'background_' | append: forloop.index
      if section.settings[key] != blank
        assign background_url = section.settings[key] | image_url: width: 2400
      else
        assign background_url = default_background | asset_url
      endif
      unless forloop.first
        echo ','
      endunless
      echo background_url | json
    endfor
  endcapture

  assign show_label = section.settings.show_label | default: 'Show fragrances'
-%}

{{ 'fragrance-scroll.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fragrance-scroll.js' | asset_url }}" defer></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
>

<fragrance-scroll data-section-id="{{ section.id }}">
  <script type="application/json" data-fs-config>
    {"showLabel":{{ show_label | json }},"fragrances":[{{ fragrances_json }}],"assets":{"bottles":{{ '{' }}{{ bottles_json }}{{ '}' }},"ingredients":{{ '{' }}{{ ingredients_json }}{{ '}' }},"backgrounds":[{{ backgrounds_json }}]}}
  </script>
  <div data-fs-mount></div>
</fragrance-scroll>

{% schema %}
{
  "name": "Fragrance scroll",
  "tag": "section",
  "class": "section-fragrance-scroll",
  "settings": [
    {
      "type": "text",
      "id": "show_label",
      "label": "Texto del botón",
      "default": "Show fragrances"
    },
    {
      "type": "header",
      "content": "Fondos"
    },
    {
      "type": "paragraph",
      "content": "Se alternan entre las fragancias. Si un fondo queda vacío se usa el del tema (bg1…bg4)."
    },
    {
      "type": "image_picker",
      "id": "background_1",
      "label": "Fondo 1"
    },
    {
      "type": "image_picker",
      "id": "background_2",
      "label": "Fondo 2"
    },
    {
      "type": "image_picker",
      "id": "background_3",
      "label": "Fondo 3"
    },
    {
      "type": "image_picker",
      "id": "background_4",
      "label": "Fondo 4"
    }
  ],
  "blocks": [
    {
      "type": "fragrance",
      "name": "Fragancia",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Fragrance",
          "info": "También define las imágenes por defecto del tema (ej. \"Wonder of the World\" → wonderOfTheWorld_botella.png)."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Producto",
          "info": "Destino del link de la botella. Si queda vacío se usa /products/<nombre>."
        },
        {
          "type": "text",
          "id": "ingredient_1",
          "label": "Ingrediente 1"
        },
        {
          "type": "text",
          "id": "ingredient_2",
          "label": "Ingrediente 2"
        },
        {
          "type": "text",
          "id": "ingredient_3",
          "label": "Ingrediente 3"
        },
        {
          "type": "header",
          "content": "Imágenes"
        },
        {
          "type": "paragraph",
          "content": "Opcionales: si quedan vacías se usan las del tema."
        },
        {
          "type": "image_picker",
          "id": "bottle",
          "label": "Botella"
        },
        {
          "type": "image_picker",
          "id": "ingredient_image_1",
          "label": "Imagen de ingrediente 1"
        },
        {
          "type": "image_picker",
          "id": "ingredient_image_2",
          "label": "Imagen de ingrediente 2"
        },
        {
          "type": "image_picker",
          "id": "ingredient_image_3",
          "label": "Imagen de ingrediente 3"
        },
        {
          "type": "header",
          "content": "Estiramiento de la imagen de ingrediente"
        },
        {
          "type": "range",
          "id": "stretch_x",
          "label": "Horizontal",
          "min": 1,
          "max": 3,
          "step": 0.1,
          "default": 1
        },
        {
          "type": "range",
          "id": "stretch_y",
          "label": "Vertical",
          "min": 1,
          "max": 3,
          "step": 0.1,
          "default": 1
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Fragrance scroll",
      "blocks": [
        { "type": "fragrance", "settings": { "title": "Rebellious", "ingredient_1": "Saffron", "ingredient_2": "Bergamot", "ingredient_3": "Caramel" } },
        { "type": "fragrance", "settings": { "title": "Forbidden Flower", "ingredient_1": "Lychee", "ingredient_2": "Bergamot", "ingredient_3": "Freesia" } },
        { "type": "fragrance", "settings": { "title": "Wonder of the World", "ingredient_1": "Almond", "ingredient_2": "Freesia", "ingredient_3": "Caramel" } },
        { "type": "fragrance", "settings": { "title": "Painkiller", "ingredient_1": "Lilac", "ingredient_2": "Bergamot", "ingredient_3": "Musk", "stretch_x": 2, "stretch_y": 1.2 } },
        { "type": "fragrance", "settings": { "title": "Jagged Edge", "ingredient_1": "Bergamot", "ingredient_2": "Tonka Bean", "ingredient_3": "Rose" } },
        { "type": "fragrance", "settings": { "title": "Crimson Desert", "ingredient_1": "Raspberry", "ingredient_2": "Mandarin", "ingredient_3": "Jasmine" } },
        { "type": "fragrance", "settings": { "title": "Glitterati", "ingredient_1": "Jasmine", "ingredient_2": "Vanilla", "ingredient_3": "Musk" } },
        { "type": "fragrance", "settings": { "title": "Ecstasy", "ingredient_1": "Black Currant", "ingredient_2": "Ginger", "ingredient_3": "Rose" } },
        { "type": "fragrance", "settings": { "title": "Epicurean", "ingredient_1": "Jasmine", "ingredient_2": "Rose", "ingredient_3": "Black Currant" } },
        { "type": "fragrance", "settings": { "title": "London Legend", "ingredient_1": "Saffron", "ingredient_2": "Bulgarian Rose", "ingredient_3": "Vanilla" } }
      ]
    }
  ]
}
